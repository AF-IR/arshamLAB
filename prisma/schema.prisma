// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * ابزارهای ویژه‌ای که از پنل مدیریت (/admin) اضافه می‌شوند.
 * این ابزارها در «تب ویژه» صفحه /tools و بخش ویژه صفحه اصلی نمایش داده می‌شوند.
 */
model SpecialTool {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  description String   @default("")
  url         String
  emoji       String   @default("✨")
  /** یکی از کلیدهای CategoryColor: blue|orange|amber|teal|purple|cyan|green|pink|slate */
  color       String   @default("pink")
  /** برچسب نمایشی روی کارت، مثل «ویژه» یا «هوش مصنوعی» */
  badge       String   @default("ویژه")
  sortOrder   Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
